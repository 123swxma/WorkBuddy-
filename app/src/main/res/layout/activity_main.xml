<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ 代理 ============ -->
        <ScrollView
            android:id="@+id/pageProxy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WorkBuddy 反代"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="本机账号池 → 标准 OpenAI / Anthropic 接口"
                    android:textColor="@color/dim"
                    android:textSize="12.5sp" />

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/dot_idle" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="服务未启动"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/addrText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text=""
                        android:textColor="@color/dim"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnToggle"
                        style="@style/BtnPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="启动服务" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="启动后服务监听本机端口，点下方「API」能看到 Base URL 与 Key。\n\n同一 Wi-Fi 下的电脑可以直接连手机的局域网地址；国产 ROM 的深度省电可能杀掉后台，建议在系统设置里给本应用开「忽略电池优化」。"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============ API 设置 ============ -->
        <ScrollView
            android:id="@+id/pageApi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 设置"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="客户端要填的地址与密钥"
                    android:textColor="@color/dim"
                    android:textSize="12.5sp" />

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API Base URL"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/baseUrlText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/brand"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/keysTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="API KEY"
                                android:textColor="@color/text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="为每个 Key 绑定专属出口，客户端用哪个 Key 就固定走哪个区域"
                                android:textColor="@color/dim"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnNewKey"
                            style="@style/BtnPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:minHeight="38dp"
                            android:minWidth="0dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="添加"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/keysPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="监听端口"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/portInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip"
                            android:hint="8788"
                            android:inputType="number"
                            android:maxLength="5"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnSavePort"
                            style="@style/BtnGhost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="保存" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="改端口需要重启服务才生效"
                        android:textColor="@color/dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============ 我的 ============ -->
        <ScrollView
            android:id="@+id/pageMine"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accountsTitle"
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号池" />

                <LinearLayout
                    android:id="@+id/accountsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnAddAccount"
                    style="@style/BtnGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="＋ 添加 WorkBuddy 账号" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:textColor="@color/dim"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/settingsCard"
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置"
                            android:textColor="@color/text"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="外观、字号、卡片密度"
                            android:textColor="@color/dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/dim"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============ 控制台：状态 / 接入信息 / 运行日志 ============ -->
        <ScrollView
            android:id="@+id/pageConsole"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="控制台"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="服务状态、接入信息与实时日志"
                    android:textColor="@color/dim"
                    android:textSize="12.5sp" />

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务状态"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/conStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="未启动"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/conAddrText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="接入信息"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/conBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/brand"
                        android:textIsSelectable="true"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/conKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text"
                        android:textIsSelectable="true"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyBaseUrl"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="复制 Base"
                            android:textSize="12.5sp" />

                        <Button
                            android:id="@+id/btnCopyApiKey"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="复制 Key"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/CardBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="运行日志"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/logAll"
                            style="@style/BtnPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:minWidth="0dp"
                            android:text="全部"
                            android:textSize="11.5sp" />

                        <Button
                            android:id="@+id/logInfo"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:minWidth="0dp"
                            android:text="INFO"
                            android:textSize="11.5sp" />

                        <Button
                            android:id="@+id/logWarn"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:minWidth="0dp"
                            android:text="WARN"
                            android:textSize="11.5sp" />

                        <Button
                            android:id="@+id/logError"
                            style="@style/BtnGhost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:minWidth="0dp"
                            android:text="ERROR"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/logSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip"
                        android:hint="过滤关键词（model / error / 账号名…）"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/text"
                        android:textSize="12sp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginTop="8dp"
                        android:background="#0B0F12"
                        android:padding="10dp"
                        android:scrollbars="vertical">

                        <TextView
                            android:id="@+id/logBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="2.5dp"
                            android:text="等待请求…"
                            android:textColor="#D5DCE2"
                            android:textSize="10sp" />
                    </ScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="每 2 秒自动刷新 · 终端样式，深色固定"
                        android:textColor="@color/dim"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenPanel"
                    style="@style/BtnGhost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开完整面板（网页版）" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- ============ 底部工具栏 ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tabProxy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="◎\n代理"
            android:textColor="@color/brand"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabApi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⌗\nAPI"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabConsole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="≡\n控制台"
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabMine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="◍\n我的"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
