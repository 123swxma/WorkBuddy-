<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/BtnGhost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="‹ 返回"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外观"
                    android:textColor="@color/text"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/themeLight"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="浅色"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/themeDark"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="深色"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字号"
                    android:textColor="@color/text"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/fontGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fontSmall"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="小"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/fontNormal"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="标准"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/fontLarge"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="大"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/fontXLarge"
                        style="@style/BtnGhost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="特大"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="卡片紧凑"
                            android:textColor="@color/text"
                            android:textSize="14.5sp" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/swCompact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 网络 -->
            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="网络"
                    android:textColor="@color/text"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="默认 8788 · 改端口后需要重启服务"
                    android:textColor="@color/dim"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="监听端口"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/setPort"
                        android:hint="8788"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingStart="8dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="允许局域网访问"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/setLan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 上游 -->
            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上游"
                    android:textColor="@color/text"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="System 提示处理（默认 auto）"
                    android:textColor="@color/dim"
                    android:textSize="11.5sp" />

                <RadioGroup
                    android:id="@+id/setPromptGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/setPromptAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="auto — 缺 system 时补一句默认"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />

                    <RadioButton
                        android:id="@+id/setPromptKeep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="keep — 原样透传"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />

                    <RadioButton
                        android:id="@+id/setPromptReplace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="replace — 统一覆盖"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="国内版对话入口（默认 copilot.tencent.com）"
                    android:textColor="@color/dim"
                    android:textSize="11.5sp" />

                <RadioGroup
                    android:id="@+id/setCnGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/setCnPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="copilot.tencent.com（国内）"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />

                    <RadioButton
                        android:id="@+id/setCnAlt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="www.workbuddy.cn（海外可用）"
                        android:textColor="@color/text"
                        android:textSize="12.5sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="国际版上游基址（默认 https://www.workbuddy.ai）"
                    android:textColor="@color/dim"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/setIntlBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip"
                    android:hint="https://www.workbuddy.ai"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="读超时（秒，默认 300）"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/setTimeout"
                        android:hint="300"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingStart="8dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="失败换号次数（默认 2）"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/setRetries"
                        android:hint="2"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:paddingStart="8dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="清理空 delta 字段"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/setClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveAdvanced"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="保存网络与上游设置" />
            </LinearLayout>

            <LinearLayout
                style="@style/CardBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textColor="@color/text"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/aboutText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResetAppearance"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="恢复默认外观" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
