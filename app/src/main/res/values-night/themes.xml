<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色主题：只覆盖 Theme.WBProxy，其余 style 自动回落到默认 values。 -->
    <style name="Theme.WBProxy" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>
</resources>
